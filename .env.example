# Vorlage für die Umgebungsvariablen – echte Werte NUR in Vercel bzw. lokal in .env.local eintragen.

# ── Variante A: Versand über das IONOS-Postfach (empfohlen) ──
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=info@ostwestglanz.de
SMTP_PASS=

# ── Variante B: Versand über Resend (hat Vorrang, wenn gesetzt) ──
# RESEND_API_KEY=

# Empfänger und Absender
CONTACT_TO=info@ostwestglanz.de
CONTACT_FROM=OstWest Glanz Website <info@ostwestglanz.de>

# Nur lokal: Mails nicht senden, sondern in der Konsole ausgeben
# CONTACT_DRY_RUN=1
